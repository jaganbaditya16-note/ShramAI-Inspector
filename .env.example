APP_ENV=development
DATABASE_URL=sqlite:///./shramai.db
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=25
MAX_REQUEST_BODY_MB=30
ALLOWED_ORIGINS=http://localhost:3000
DEMO_AUTH_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Docker Compose uses PostgreSQL automatically.
# For production, provide a managed PostgreSQL DATABASE_URL and durable
# private object storage instead of the local SQLite/filesystem defaults.
