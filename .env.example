# ============================================================
# ShramAI Inspector — environment configuration
# Copy to .env (apps/api/.env for local API runs) and adjust.
# Never commit real secrets.
# ============================================================

# --- Application ---------------------------------------------
APP_ENV=development            # local | development | demo | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | console

# --- Database --------------------------------------------------
# Production MUST use durable PostgreSQL. SQLite is for local/demo only.
DATABASE_URL=sqlite:///./shramai.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/shramai
# Auto-create tables at startup (SQLite convenience only; use migrations in prod).
# DB_AUTO_CREATE=false

# --- Storage ----------------------------------------------------
# local: development/demo only (startup refuses it in production).
# s3: private S3-compatible object storage (AWS S3, MinIO, R2, ...).
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# S3-compatible object storage (required when STORAGE_BACKEND=s3).
# Credentials come from the environment only — never hard-code them.
# Objects are always PRIVATE; downloads stream through the authorised API.
# S3_ENDPOINT_URL=                     # set for MinIO/R2/Spaces, empty = AWS
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_SERVER_SIDE_ENCRYPTION=AES256     # or aws:kms (encryption at rest)
# Downloads stream through the API by default. Enable only if you want the
# download endpoint to redirect to a SHORT-LIVED presigned GET instead.
# S3_PRESIGNED_DOWNLOADS=false
# S3_PRESIGN_TTL_SECONDS=300           # 30..3600

# --- Upload / extraction limits -----------------------------------
MAX_UPLOAD_MB=25
MAX_REQUEST_BODY_MB=30
MAX_PDF_PAGES_TEXT=60
MAX_PAGES_OCR=15
OCR_DPI_SCALE=2.0
MAX_EXTRACT_CHARS=500000

# --- Malware scanning (pre-processing stage) ---------------------------
# off: development/demo — uploads are marked scan_status=skipped and never
#      claimed clean; production startup refuses to boot with scanning off.
# enforcing: every upload is streamed to a ClamAV clamd daemon; any scanner
#      failure blocks the upload (fail-closed).
MALWARE_SCAN_MODE=off
CLAMD_HOST=                    # clamd TCP host (required when enforcing)
CLAMD_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=10
MALWARE_SCAN_STREAM_CHUNK=65536

# --- HTTP ------------------------------------------------------
# Comma-separated CORS allow-list (empty = same-origin only, the default setup).
ALLOWED_ORIGINS=
TRUST_PROXY_HEADERS=false      # true behind a TLS-terminating proxy

# --- Authentication ----------------------------------------------
# demo: public demo with a virtual demo principal (synthetic data only).
# required: organisational users, roles and cookie sessions.
AUTH_MODE=demo
SESSION_TTL_MINUTES=10080
# Bootstrap admin (auth_mode=required). BOTH are required in production.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Chief Inspector
BOOTSTRAP_ADMIN_PASSWORD=

# --- OIDC / enterprise SSO (AUTH_MODE=oidc) -----------------------------
# Provider-agnostic (Keycloak, Entra ID, Okta, Google, ...). Secrets live in
# the environment only — never in source, never in logs.
# AUTH_MODE=oidc
# OIDC_ISSUER=                       # https://idp.example.com/realms/shramai
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=                 # absolute callback URL (https in production)
# OIDC_SCOPES="openid email profile"
# OIDC_ORG_NAME=Inspectorate Organisation
# OIDC_DEFAULT_ROLE=inspector        # viewer | inspector | admin
# OIDC_STATE_SECRET=                 # dedicated HMAC key for the flow cookie
# OIDC_LOCAL_LOGIN_FALLBACK=true     # keep password login as break-glass
# OIDC_POST_LOGIN_REDIRECT=/
# OIDC_HTTP_TIMEOUT_SECONDS=10
# OIDC_TOKEN_LEEWAY_SECONDS=60

# --- Background pipeline -------------------------------------------
PIPELINE_MODE=background       # background | inline
PIPELINE_CONCURRENCY=2

# --- Rate limiting (per instance) -------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=240
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- AI provider (local Ollama; no data leaves the host) ----------------
# Leave OLLAMA_MODEL empty to run deterministic rules only.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=45
AI_INPUT_CHAR_LIMIT=60000

# --- Knowledge base ------------------------------------------------
# Directory of approved, versioned reference documents (markdown).
# Empty = repo data/knowledge when present.
KNOWLEDGE_DIR=
